{
  "name": "ground-truth-app",
  "version": "1.0.0",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "start": "NODE_ENV=production node --env-file-if-exists=./.env ./dist/server.js",
    "dev": "NODE_ENV=development tsx watch --tsconfig ./tsconfig.server.json --env-file-if-exists=./.env ./server/server.ts",
    "build:client": "tsc -b tsconfig.client.json && vite build --config client/vite.config.ts",
    "build:server": "tsc -b tsconfig.server.json && tsdown -c tsdown.server.config.ts",
    "build": "pnpm run build:server && pnpm run build:client",
    "typecheck": "tsc -b tsconfig.server.json && tsc -b tsconfig.client.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ast-grep": "appkit lint",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "clean": "rm -rf client/dist dist build node_modules",
    "prebuild": "pnpm run sync && appkit generate-types --wait && vitest run",
    "predev": "pnpm run sync && pnpm run typegen",
    "sync": "appkit plugin sync --write --silent",
    "typegen": "appkit generate-types",
    "setup": "appkit setup --write"
  },
  "keywords": [],
  "author": "",
  "license": "Unlicensed",
  "description": "A Databricks App powered by AppKit",
  "dependencies": {
    "@databricks/appkit": "0.89.0",
    "@databricks/appkit-ui": "0.89.0",
    "@databricks/sdk-experimental": "0.17.0",
    "@mlflow/core": "0.4.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.23.0",
    "@tanstack/react-query": "^5.90.0",
    "clsx": "2.1.1",
    "embla-carousel-react": "8.6.0",
    "framer-motion": "^12.23.0",
    "next-themes": "0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-resizable-panels": "3.0.6",
    "react-router": "7.18.4",
    "tailwind-merge": "3.3.1",
    "tailwindcss-animate": "1.0.7",
    "tw-animate-css": "1.4.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@ast-grep/napi": "0.37.0",
    "@eslint/compat": "2.0.0",
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/vite": "4.1.17",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/express": "5.0.5",
    "@types/node": "24.6.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.48.0",
    "@typescript-eslint/parser": "8.48.0",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "jsdom": "30.1.3",
    "prettier": "3.6.2",
    "tailwindcss": "4.0.14",
    "tsdown": "0.20.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "npm:rolldown-vite@7.1.14",
    "vitest": "4.1.12",
    "vitest-axe": "0.1.0"
  },
  "optionalDependencies": {
    "@ast-grep/napi-linux-x64-gnu": "0.37.0"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.1.14",
    "@opentelemetry/core": "2.8.0",
    "systeminformation": "5.33.18",
    "fast-uri": "3.1.9",
    "socks": "2.8.7",
    "bare-path": "3.1.1",
    "bare-url": "2.5.2",
    "dompurify": "3.4.17",
    "echarts": "6.1.0",
    "js-yaml@4.3.1": "4.3.2",
    "yaml": "2.8.3",
    "qs": "6.16.1"
  }
}
