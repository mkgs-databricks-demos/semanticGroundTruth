{
  "datasets": [
    {
      "name": "ds_total_votes",
      "displayName": "KPI: Total Votes",
      "queryLines": [
        "SELECT MEASURE(`Total Votes`) AS total_votes FROM mv_review_activity"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_approval_rate",
      "displayName": "KPI: Approval Rate",
      "queryLines": [
        "SELECT MEASURE(`Approval Rate`) AS approval_rate FROM mv_review_activity"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_certified_assets",
      "displayName": "KPI: Certified Assets",
      "queryLines": [
        "SELECT MEASURE(`Certified Assets`) AS certified_assets, MEASURE(`Total Assets`) AS total_assets FROM mv_coverage_metrics"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_active_reviewers",
      "displayName": "KPI: Active Reviewers",
      "queryLines": [
        "SELECT MEASURE(`Active Reviewers`) AS active_reviewers FROM mv_user_leaderboard"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_review_trend",
      "displayName": "Review Activity by Day",
      "queryLines": [
        "SELECT vote_date, MEASURE(`Total Votes`) AS total_votes, MEASURE(`Unique Reviewers`) AS unique_reviewers FROM mv_review_activity GROUP BY vote_date ORDER BY vote_date"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_skipped_cards",
      "displayName": "KPI: Skipped Cards",
      "queryLines": [
        "SELECT MEASURE(`skips`) AS skipped_cards, MEASURE(`skip_rate`) AS skip_rate FROM mv_review_activity"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_skip_rate_trend",
      "displayName": "Skip Rate by Day",
      "queryLines": [
        "SELECT vote_date, MEASURE(`skip_rate`) AS skip_rate, MEASURE(`skips`) AS skips FROM mv_review_activity GROUP BY vote_date ORDER BY vote_date"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_campaign_progress",
      "displayName": "Campaign Progress",
      "queryLines": [
        "SELECT campaign_type, campaign_status, MEASURE(`Total Assets`) AS total_assets, MEASURE(`Reviewed Assets`) AS reviewed_assets, MEASURE(`Avg Completion`) AS avg_completion FROM mv_campaign_progress GROUP BY campaign_type, campaign_status ORDER BY campaign_type"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_asset_status",
      "displayName": "Asset Status Mix",
      "queryLines": [
        "SELECT status, MEASURE(`Total Assets`) AS total_assets FROM mv_coverage_metrics GROUP BY status ORDER BY status"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_error_rate",
      "displayName": "App Error Rate",
      "queryLines": [
        "SELECT log_date, MEASURE(`Error Rate`) AS error_rate, MEASURE(`Error Count`) AS error_count, MEASURE(`Total Logs`) AS total_logs FROM mv_otel_error_rate GROUP BY log_date ORDER BY log_date"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    },
    {
      "name": "ds_latency",
      "displayName": "App Request Latency",
      "queryLines": [
        "SELECT span_date, MEASURE(`P95 Latency`) AS p95_latency_ms, MEASURE(`Avg Latency`) AS avg_latency_ms, MEASURE(`Request Count`) AS request_count FROM mv_otel_request_latency GROUP BY span_date ORDER BY span_date"
      ],
      "catalog": "hls_fde_dev",
      "schema": "dev_matthew_giglia_semantic_ground_truth"
    }
  ],
